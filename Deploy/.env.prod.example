# Copy to Deploy/.env.prod on the VM and fill in. Never commit the real file.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# Deploy/.env.prod is gitignored by the dedicated `Deploy/.env.*` rule — the
# repo-wide `*.env` rule does NOT cover it, since that matches names *ending*
# in .env. Run `git check-ignore -v Deploy/.env.prod` before writing secrets.

# --- LLM (the operator pays for this) ---------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Backend is fixed server-side; visitors cannot change it in the browser.
IGVF_LLM_BACKEND=anthropic

# Default model selection, and the allowlist a visitor may pick from.
# Leave IGVF_PUBLIC_MODELS empty for the built-in catalog, ordered
# cheapest-first: Sonnet 5 (default), Haiku 4.5, Opus 5, Fable 5. Set it to
# restrict the menu — e.g. drop Fable 5 ($10/$50 per Mtok, ~3.3x Sonnet) to
# cap the worst case a single visitor can cost:
#   IGVF_PUBLIC_MODELS=claude-sonnet-5,claude-haiku-4-5,claude-opus-5
IGVF_LLM_MODEL=claude-sonnet-5
IGVF_PUBLIC_MODELS=
IGVF_LLM_TIMEOUT=900

# --- Spend guardrails -------------------------------------------------------
# Every iteration is one LLM call, so this is the main cost lever per visitor.
# One iteration == one LLM call. Bulk work ("download all 76 scE2G sets and
# integrate them") needs roughly one per object plus discovery and synthesis;
# below that the run is cut short, not slowed down.
IGVF_PUBLIC_MAX_ITER=100
IGVF_PUBLIC_DEFAULT_ITER=25
IGVF_PUBLIC_MAX_TOKENS=16384

# Tool-catalog size offered to the model. The built-in default (128) is fewer
# than the 148 registered tools, and the overflow is dropped alphabetically —
# silently hiding whole families (sce2g_*, splitseq_*, starr_*, share_*, sc_*).
# Anthropic accepts the full set; OpenAI's function limit is 128, so lower
# this if you point the deployment at an OpenAI-family backend.
IGVF_LLM_MAX_TOOLS=200

# --- Cloudflare Tunnel ------------------------------------------------------
# From: Cloudflare dashboard > Zero Trust > Networks > Tunnels > create,
# or `cloudflared tunnel create` + token. Maps igvfagent.genohub.org -> gateway:80
CF_TUNNEL_TOKEN=

# --- Self-extension -----------------------------------------------------
# 1 lets the agent write new tools/skills from chat (ext_author_tool /
# ext_author_skill). Those skills are Python this host later runs as a
# subprocess, so on a shared deployment anyone with the password can execute
# code here. Enable deliberately.
IGVF_ALLOW_AGENT_AUTHORING=0
# Keep authored extensions on the mounted volume so a redeploy doesn't wipe them.
IGVF_USER_EXT_DIR=/workspace/Data/UserExtensions

# --- Optional IGVF credentials ----------------------------------------------
# Only needed for unreleased Portal datasets / non-guest ArangoDB.
IGVF_PORTAL_COOKIE=
IGVF_ARANGO_PASSWORD=
