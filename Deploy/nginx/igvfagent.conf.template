# Auth gate + WebSocket-aware reverse proxy in front of Streamlit.
#
# This file is an envsubst TEMPLATE, rendered by the nginx image's
# /docker-entrypoint.d/20-envsubst-on-templates.sh at container start.
# NGINX_ENVSUBST_FILTER is set to ^GA_ in the compose file so ONLY
# ${GA_MEASUREMENT_ID} is substituted — without that filter envsubst would
# also eat nginx's own $host, $http_upgrade, $remote_addr … and the config
# would render into nonsense.
#
# Streamlit is not a plain request/response app: the browser loads a small
# shell over HTTP and then everything real happens on a long-lived WebSocket
# at /_stcore/stream. A naive proxy_pass serves the shell and then hangs with
# a blank page, so the Upgrade/Connection handling and the long read timeout
# below are load-bearing, not boilerplate.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Safari does NOT attach HTTP Basic Auth credentials to a WebSocket
# handshake. Chrome and Firefox reuse them for a same-origin upgrade; Safari
# sends the upgrade with no Authorization header at all. Streamlit loads its
# HTML shell over plain HTTP (which DOES carry the credentials, so the page
# appears to start) and then runs everything on a WebSocket to
# /_stcore/stream -- which nginx refused. Measured in this gateway's own log:
# 39 x 101 upgraded (all Chrome/Firefox) against 112 x 401 (all Safari,
# macOS and iOS, retrying every few seconds on Streamlit's reconnect loop).
#
# Safari DOES send cookies on a WebSocket handshake. So the authenticated
# HTML location below hands out a token cookie, and the WebSocket location
# accepts that cookie INSTEAD of basic auth. Same shared secret, same
# strength as the single shared password already in use -- and emphatically
# not the same as turning auth off on that path, which would let anyone open
# a socket and drive the agent without a password. The shell is not where the
# work happens.
map $http_cookie $igvf_ws_ok {
    default                     0;
    "~*igvf_ws=${WS_TOKEN}"     1;
}

server {
    listen 80;
    server_name igvfagent.genohub.org _;

    # Analyses stream artefacts back; allow generous uploads for h5ad etc.
    client_max_body_size 2048m;

    # Cloudflare already terminates TLS and sets these; keep real client IPs
    # in the access log so abuse is attributable to something.
    real_ip_header CF-Connecting-IP;
    set_real_ip_from 0.0.0.0/0;

    # Belt and braces behind the tunnel.
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Unauthenticated liveness probe for `docker compose ps` / uptime checks.
    location = /healthz {
        auth_basic off;
        access_log off;
        proxy_pass http://app:8501/_stcore/health;
    }

    # WebSocket: cookie-gated rather than basic-auth-gated, for the Safari
    # reason above. Everything else about the proxying is identical to
    # `location /` -- an upgrade still needs the Upgrade/Connection headers
    # and the long read timeout, and losing either here would reproduce the
    # blank page for every browser instead of one.
    location = /_stcore/stream {
        auth_basic off;
        if ($igvf_ws_ok = 0) { return 401; }

        proxy_pass http://app:8501;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout  86400s;
        proxy_send_timeout  86400s;
        proxy_buffering     off;
    }

    location / {
        auth_basic           "IGVFagent — shared lab access";
        auth_basic_user_file /etc/nginx/htpasswd;

        # --- Google Analytics -------------------------------------------
        # Streamlit serves a fixed SPA shell and offers no head-injection
        # hook: st.markdown strips <script>, and components.v1.html renders
        # inside an iframe, so gtag would measure the iframe rather than the
        # page. Splicing the tag in at the proxy is the only placement that
        # actually reports this site.
        #
        # sub_filter cannot rewrite a compressed body, so ask the upstream
        # for identity encoding. (Streamlit does not gzip this response
        # today; this keeps the filter working if that ever changes.)
        # Handed out only after basic auth has passed, so possession of the
        # cookie is evidence of having authenticated. add_header does not
        # inherit into a location that sets any of its own, so the three
        # server-level security headers are repeated here deliberately --
        # without them this fix would quietly remove them from every HTML
        # response.
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Set-Cookie "igvf_ws=${WS_TOKEN}; Path=/; HttpOnly; Secure; SameSite=Lax" always;

        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        sub_filter_types text/html;
        sub_filter '</head>' "<script async src=\"https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}\"></script><script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_MEASUREMENT_ID}');</script></head>";

        proxy_pass http://app:8501;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # WebSocket upgrade for /_stcore/stream.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # A multi-step agent run can think for minutes between frames; the
        # default 60s read timeout would drop the socket mid-analysis and
        # the UI would silently stop updating. Bulk download + KG integration
        # jobs run for hours, so this is a day, not an hour — the ceiling
        # should never be the thing that ends a legitimate run.
        proxy_read_timeout  86400s;
        proxy_send_timeout  86400s;
        proxy_buffering     off;
    }
}
