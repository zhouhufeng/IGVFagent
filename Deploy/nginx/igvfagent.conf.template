# Authentication gate + WebSocket-aware reverse proxy in front of Streamlit.
#
# This file is an envsubst TEMPLATE, rendered by the nginx image's
# /docker-entrypoint.d/20-envsubst-on-templates.sh at container start.
# NGINX_ENVSUBST_FILTER is set in the compose file so ONLY the variables
# listed there are substituted — without that filter envsubst would also eat
# nginx's own $host, $http_upgrade, $remote_addr … and the config would render
# into nonsense.
#
# Streamlit is not a plain request/response app: the browser loads a small
# shell over HTTP and then everything real happens on a long-lived WebSocket
# at /_stcore/stream. A naive proxy_pass serves the shell and then hangs with
# a blank page, so the Upgrade/Connection handling and the long read timeout
# below are load-bearing, not boilerplate.
#
# AUTHENTICATION. Every request is settled by auth_request against the gate
# service, which checks one signed cookie. There is no shared password any
# more: identity comes from the Genohub Discourse forum and access requires
# membership of a group an administrator controls (Deploy/auth/gate.py).
#
# This also retires the Safari workaround that used to live here. Safari does
# not send HTTP Basic Auth credentials on a WebSocket handshake — it does send
# cookies — so the old config had to gate the socket on a separate shared
# token while the page used basic auth. Cookie-based sessions make that
# distinction disappear: the HTML and the WebSocket are now checked exactly
# the same way, by the same subrequest, which is one fewer thing to get wrong.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name igvfagent.genohub.org _;

    # Analyses stream artefacts back; allow generous uploads for h5ad etc.
    client_max_body_size 2048m;

    # Emit RELATIVE Location headers. Cloudflare terminates TLS, so nginx sees
    # plain HTTP and would build `http://igvfagent.genohub.org/_auth/login`
    # from $scheme — bouncing every unauthenticated visitor through an
    # unencrypted hop on the way to the login page. A relative Location is
    # resolved by the browser against the scheme it is already using.
    absolute_redirect off;

    # Cloudflare already terminates TLS and sets these; keep real client IPs
    # in the access log so abuse is attributable to something.
    real_ip_header CF-Connecting-IP;
    set_real_ip_from 0.0.0.0/0;

    # Belt and braces behind the tunnel.
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # ---------------------------------------------------------------- auth --
    # The gate's own endpoints must NOT require auth — /_auth/login is how an
    # unauthenticated person starts, and gating it would be a redirect loop.
    location /_auth/ {
        proxy_pass http://auth:9000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Internal subrequest target. `internal` keeps it unreachable from
    # outside: without it a client could call /_auth/verify directly and read
    # back the identity headers of whatever cookie it holds.
    location = /_auth/verify {
        internal;
        proxy_pass http://auth:9000/_auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
    }

    # An unauthenticated request is bounced to the gate, which bounces it to
    # Discourse. 302 rather than 401 so a browser hitting the site cold lands
    # on a login page instead of an empty error.
    location @start_login {
        return 302 /_auth/login;
    }

    # Unauthenticated liveness probe for `docker compose ps` / uptime checks.
    location = /healthz {
        access_log off;
        proxy_pass http://app:8501/_stcore/health;
    }

    # WebSocket. Same auth_request as everything else now — see the note at
    # the top about why this used to be special. An upgrade still needs the
    # Upgrade/Connection headers and the long read timeout, and losing either
    # here would reproduce the blank page for every browser.
    location = /_stcore/stream {
        auth_request /_auth/verify;
        # A dead socket cannot follow a redirect, so an expired session gets a
        # plain 401 here; Streamlit's reconnect loop surfaces it and a page
        # reload then goes through the normal login redirect.
        error_page 401 = @ws_denied;

        auth_request_set $igvf_user  $upstream_http_x_igvf_user;
        auth_request_set $igvf_email $upstream_http_x_igvf_email;
        auth_request_set $igvf_name  $upstream_http_x_igvf_name;
        auth_request_set $igvf_admin $upstream_http_x_igvf_admin;

        proxy_pass http://app:8501;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-IGVF-User       $igvf_user;
        proxy_set_header X-IGVF-Email      $igvf_email;
        proxy_set_header X-IGVF-Name       $igvf_name;
        proxy_set_header X-IGVF-Admin      $igvf_admin;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout  86400s;
        proxy_send_timeout  86400s;
        proxy_buffering     off;
    }

    location @ws_denied {
        return 401;
    }

    location / {
        auth_request /_auth/verify;
        error_page 401 403 = @start_login;

        # Identity, read back out of the subrequest response and handed to the
        # app. The app trusts these headers because nothing can reach it
        # except through this server block — it listens only on the compose
        # network and is never published to a host port.
        auth_request_set $igvf_user  $upstream_http_x_igvf_user;
        auth_request_set $igvf_email $upstream_http_x_igvf_email;
        auth_request_set $igvf_name  $upstream_http_x_igvf_name;
        auth_request_set $igvf_admin $upstream_http_x_igvf_admin;

        # --- Google Analytics -------------------------------------------
        # Streamlit serves a fixed SPA shell and offers no head-injection
        # hook: st.markdown strips <script>, and components.v1.html renders
        # inside an iframe, so gtag would measure the iframe rather than the
        # page. Splicing the tag in at the proxy is the only placement that
        # actually reports this site.
        #
        # sub_filter cannot rewrite a compressed body, so ask the upstream
        # for identity encoding. (Streamlit does not gzip this response
        # today; this keeps the filter working if that ever changes.)
        #
        # add_header does not inherit into a location that sets any of its
        # own, so the three server-level security headers are repeated here
        # deliberately — without them this block would quietly remove them
        # from every HTML response.
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;

        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        sub_filter_types text/html;
        sub_filter '</head>' "<script async src=\"https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}\"></script><script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_MEASUREMENT_ID}');</script></head>";

        proxy_pass http://app:8501;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-IGVF-User       $igvf_user;
        proxy_set_header X-IGVF-Email      $igvf_email;
        proxy_set_header X-IGVF-Name       $igvf_name;
        proxy_set_header X-IGVF-Admin      $igvf_admin;

        # WebSocket upgrade for any path Streamlit adds later.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # A multi-step agent run can think for minutes between frames; the
        # default 60s read timeout would drop the socket mid-analysis and
        # the UI would silently stop updating. Bulk download + KG integration
        # jobs run for hours, so this is a day, not an hour — the ceiling
        # should never be the thing that ends a legitimate run.
        proxy_read_timeout  86400s;
        proxy_send_timeout  86400s;
        proxy_buffering     off;
    }
}
