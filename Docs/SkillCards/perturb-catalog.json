          "journal": "Science",
          "year": 2024,
          "doi": "10.1126/science.adh0559",
          "pmid": "38781390",
          "pmc": "PMC12085231"
        },
        "checks": 1,
        "run": "Benchmarks/deng2024_cortex_mpra/run.sh"
      },
      {
