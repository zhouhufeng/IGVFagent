# IGVF Agent environment example
# Copy to .env and fill in locally. NEVER commit .env.

IGVF_CATALOG_API_BASE="https://api.catalogkg.igvf.org"
IGVF_CATALOG_DOCS_BASE="https://docs.catalog.igvf.org"
IGVF_PORTAL_BASE="https://data.igvf.org"
ENCODE_BASE="https://www.encodeproject.org"
FAVOR_API_BASE="https://api.genohub.org"

# Optional: authenticated IGVF Portal cookie for unreleased datasets.
# Export the cookie value from your browser; do not commit it.
# IGVF_PORTAL_COOKIE=""

# IGVF Knowledge Graph (ArangoDB) — guest credentials documented in IGVF Catalog.
IGVF_ARANGO_BASE="https://db.catalog.igvf.org/_db/igvf"
IGVF_ARANGO_USER="guest"
IGVF_ARANGO_PASSWORD=""
