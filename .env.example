# IGVF Agent local environment.
# Copy this file to .env and fill in the values you need; .env is gitignored.
# All variables below are OPTIONAL. The scripts ship with sensible defaults
# so the agent works out of the box. Set a variable only when you need to
# override the default or supply a credential.

# --- Service base URL overrides --------------------------------------------
# Leave these unset unless you need to point the agent at a non-default host.
# IGVF_CATALOG_API_BASE=
# IGVF_CATALOG_DOCS_BASE=
# IGVF_PORTAL_BASE=
# IGVF_PORTAL_API_BASE=
# IGVF_ARANGO_BASE=
# ENCODE_BASE=
# FAVOR_API_BASE=

# --- Authenticated access --------------------------------------------------
# IGVF Portal cookie (export from a logged-in browser session). Required
# only for unreleased portal datasets.
# IGVF_PORTAL_COOKIE=

# IGVF Knowledge Graph (ArangoDB) credentials. Defaults to read-only guest.
# IGVF_ARANGO_USER=guest
# IGVF_ARANGO_PASSWORD=

# --- Repo layout -----------------------------------------------------------
# Override repo root when running scripts from outside the cloned directory.
# IGVF_PROJECT_ROOT=
