{
  "paper": {
    "authors": "Waters AJ et al.",
    "journal": "Nat Genet",
    "year": 2024,
    "doi": "10.1038/s41588-024-01799-3",
    "pmid": "38969833"
  },
  "data_source": { "type": "mavedb", "urn": "urn:mavedb:00001210-a-1" },
  "skill_output_dir": "MaveDB",
  "label": "waters2024_bap1",
  "primary_artefact": "summary.json",
  "checks": [
    {
      "name": "MaveDB CSV downloaded + parsed (rows in)",
      "type": "range",
      "path": "n_rows_in",
      "min": 15000,
      "max": 25000,
      "expected": 18108
    },
    {
      "name": "Mapped output rows produced (chr/pos/ref/alt)",
      "type": "range",
      "path": "n_mapped_rows_out",
      "min": 5000,
      "max": 80000,
      "expected": 17000
    },
    {
      "name": "Canonical Ensembl transcript resolved (BAP1)",
      "type": "in_set",
      "path": "gene",
      "allowed": ["BAP1"]
    },
    {
      "name": "VCF artefact written",
      "type": "artefact",
      "filename": "BAP1_mapped.vcf"
    },
    {
      "name": "Per-variant TSV written",
      "type": "row_count_tsv",
      "filename": "BAP1_mapped.tsv",
      "min": 5000,
      "max": 80000,
      "expected": 17000
    }
  ]
}
