# OS
.DS_Store
._*
.AppleDouble
Thumbs.db

# Python
__pycache__/
.pycache/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local secrets and authenticated session material
.env
*.env
*.cookies
*.cookie
*.token
# API keys and any other secret material — never commit anything under the
# secrets folder. All three spellings are ignored: the correct one, the
# singular in actual use, and the historical "Secretes" typo.
Docs/Secret/
Docs/Secretes/
Docs/Secrets/
# Belt and braces: any path segment named Secret/Secrets, at any depth.
**/Secret/
**/Secrets/
**/APIkeys.txt
*APIkeys*
*apikeys*

# Runtime outputs. Keep folder placeholders and READMEs tracked.
Data/*
!Data/.gitkeep
!Data/README.md
!Data/Input/
Data/Input/*
!Data/Input/VariantList/
Data/Input/VariantList/*
!Data/Input/VariantList/README.md
!Data/Input/VariantList/example_variants.csv
# Reference data (small, version-controlled): SPLiT-seq barcode
# whitelist, future canonical lookups.
!Data/Reference/
Data/Reference/*
!Data/Reference/SPLiTseq/
Data/Reference/SPLiTseq/*
!Data/Reference/SPLiTseq/README.md
!Data/Reference/SPLiTseq/barcodes_rd1.tsv
!Data/Reference/SPLiTseq/barcodes_rd2.tsv
!Data/Reference/SPLiTseq/barcodes_rd3.tsv

Docs/Logs/*
!Docs/Logs/.gitkeep
!Docs/Logs/README.md

# Generated run outputs (timestamped) under Docs/* — re-add specific files explicitly if needed
Docs/CRISPRi/2*
Docs/MPRA/2*
Docs/SHAREseq/2*
Docs/STARRseq/2*
Docs/FlowFISH/2*
Docs/SingleCell/2*
Docs/EnhancerGene/2*
Docs/VariantAnnotation/2*
Docs/Multiome10x/2*
Docs/SpecializedIGVF/2*
Docs/cCRELinkage/2*
Docs/DataIllustration/2*
Docs/AdvancedVariantAnalysis/2*
Docs/AdvancedVariantAnalysis/PutamenMultiome/
Docs/References/2*
Docs/Benchmark/2*
Docs/SPLiTseq/2*
Docs/KGTraversal/2*
Docs/PortalToKG/2*
Docs/Agent/2*
Docs/ENCODE/2*
Docs/SETargets/2*
Docs/GEO/2*
Docs/Proteomics/2*
Docs/Perturbation/2*
# Docs/MultiSeq runs ARE tracked (worked examples, plots, classifications)
# — but skip the large per-cell × per-tag posterior matrix that
# regenerates trivially from any rerun.
Docs/MultiSeq/**/posteriors.csv
Docs/MultiSeq/**/posteriors.csv.gz
Docs/RNAseq/2*
Docs/MultiomeSurvey/2*
Docs/Enrichment/2*
Docs/MaveDB/2*
Docs/PortalQuery/2*
Docs/CatalogQuery/2*
Docs/ChIPAtlas/2*
Docs/Calibration/2*
Docs/Benchmarks/*/2*

# Benchmarks/results/ holds per-run concordance JSON+MD; per-run dirs
# under Docs/<skill>/ are already ignored by the per-skill rules above.
Benchmarks/results/2*
# Benchmarks/_data/ holds large public datasets downloaded by each run.sh
# (CELLxGENE h5ad, GEO count matrices, etc.) — never committed; re-fetched on run.
Benchmarks/_data/
Docs/Demos/*
!Docs/Demos/12_demo_questions.md

# Plots subfolders are generated artifacts
Docs/*/Plots/

# Local helper scripts (not part of the public deploy)
clean_and_push.sh

# Local-only deliverables (slides, paper drafts) — not pushed
Docs/Slides/
Docs/Paper/
Scripts/_make_overview_slides.py

# Claude Code per-developer state — keep .claude/skills/ tracked but
# exclude per-machine settings + the parallel-worktree directory.
.claude/settings.local.json
.claude/worktrees/

# transient run logs (Claude Code sessions)
scratch_*.log
